// Prisma schema — Postgres, hosted on Supabase.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase's Supavisor pooler, port 6543) — safe for
  // the high concurrent connection counts a serverless app sees at scale,
  // since Postgres itself has a hard connection limit.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection (port 5432), used only for
  // migrations/`db push`.
  directUrl = env("DIRECT_URL")
}

// The single digital product being sold. Admin edits this from /admin.
model Product {
  id               String   @id @default(cuid())
  title            String   @default("The Ecommerce Playbook – Start, Sell & Scale Your Ecommerce Business")
  tagline          String   @default("A Practical Beginner's Guide to Start, Sell & Scale an Ecommerce Business")
  aboutTitle       String   @default("About the page")
  about            String   @default("")
  bullets          String[] @default([])
  learnFrom        String   @default("Direct2Hub")
  learnFromBio     String   @default("")
  contactPhone     String   @default("")
  whatsappUrl      String   @default("")
  // Separate from whatsappUrl above: whatsappUrl is the "chat with us"
  // contact link (contact page, product page social icon); this is the
  // "join our community" group invite link shown to buyers after payment
  // (see WhatsAppGate / app/access/[token]/page.tsx). Two different links
  // for two different purposes — don't collapse them back into one.
  whatsappGroupUrl String   @default("")
  youtubeUrl       String   @default("")
  instagramUrl     String   @default("")
  logoUrl          String   @default("/uploads/logo-placeholder.png")
  heroImageUrl     String   @default("/uploads/hero-placeholder.png")
  videoUrl         String   @default("/videos/showcase.mp4")
  // "Peek inside the playbook" chapter-preview cards on the About page.
  // Editable from /admin -> Media so they're no longer hardcoded files
  // that can silently go missing from a deploy (see CHANGES.md).
  previewImage1Url String   @default("/uploads/pdf-preview/page-01.jpg")
  previewImage2Url String   @default("/uploads/pdf-preview/page-02.jpg")
  previewImage3Url String   @default("/uploads/pdf-preview/page-03.jpg")
  pdfUrl           String   @default("")
  pdfSizeKb        Int      @default(0)
  // Business/legal details shown on the Privacy Policy and Contact page.
  // Left blank by default (never fake-filled) — the storefront hides the
  // "Business details" section entirely until these are set. India's
  // Consumer Protection (E-Commerce) Rules and the DPDP Act expect a
  // seller's registered name/address and a named grievance contact to be
  // published, so these should be filled in via /admin before going live.
  businessLegalName    String @default("")
  registeredAddress    String @default("")
  grievanceOfficerName String @default("")
  grievanceOfficerEmail String @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// One row per person who fills the form. Access is gated behind payment —
// accessToken only unlocks the download page once paymentStatus is "paid".
model Submission {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  countryCode       String
  whatsapp          String
  accessToken       String    @unique
  viewCount         Int       @default(0)
  downloadCount     Int       @default(0)
  paymentStatus     String    @default("pending") // pending | paid | failed
  amountPaise       Int       @default(0)
  // PayU: the txnid of the payment attempt that was actually paid (or,
  // until then, the latest attempt) and PayU's own payment id (mihpayid).
  // The submission a callback/verify belongs to is resolved via udf1 (see
  // lib/payuFinalize.ts), not by looking this field up — so a late or
  // duplicate confirmation for an older attempt still finds the right
  // buyer even after a newer attempt has overwritten these two fields.
  payuTxnId         String?   @unique
  payuPaymentId     String?   @unique
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  // Each browser that claims this link (up to MAX_DEVICES, see
  // lib/tokens.ts) adds its own secret here and gets it set as a cookie.
  // This is what stops the link from being freely shareable — a genuine
  // buyer can still open it from e.g. their phone AND their laptop, but
  // once the array is full, anyone else who opens the same link is shown
  // a blocked page instead of the download, since their browser won't
  // carry a matching cookie.
  deviceTokens      String[]  @default([])
  // "Filled the form but never paid" reminder emails (see
  // /api/cron/reminders). reminderCount also doubles as an index into the
  // fixed schedule of reminders (10 min, 1 hour, 24 hours after
  // createdAt) — reminderCount = 2 means the 10-min and 1-hour reminders
  // have gone out and only the 24-hour one is left; once it hits 3, no
  // more are ever sent for this submission.
  reminderCount     Int       @default(0)
  lastReminderAt    DateTime?

  @@unique([countryCode, whatsapp])
  @@index([createdAt])
  @@index([paymentStatus, reminderCount])
  // Powers the admin submissions filter (status + date range combined) —
  // see lib/submissionFilters.ts.
  @@index([paymentStatus, createdAt])
}

// One row per unique visitor per IST calendar day. The visitor is an
// anonymous random id stored in a first-party cookie (lib/visitor.ts) —
// no IP address or personal data is kept. The @@unique constraint is what
// makes tracking idempotent: hitting /api/track-visit many times in the
// same day for the same browser (page refreshes, multiple pages viewed)
// never creates more than one row, which is what keeps "visitors" an
// actual unique-visitor count instead of a page-view counter that
// inflates every time someone reloads.
model Visit {
  id        String   @id @default(cuid())
  visitorId String
  day       String // IST calendar day, "YYYY-MM-DD"
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@unique([visitorId, day])
  @@index([day])
}

// Public product reviews shown at the bottom of the homepage. Anyone can
// submit one via the review form; they're published immediately. Each
// reviewer gets a private edit token (hashed here) so they can edit or
// remove their own review later; admins can moderate any review.
model Review {
  id            String   @id @default(cuid())
  name          String
  rating        Int
  comment       String
  editTokenHash String?
  // Set only when the reviewer proved a paid purchase (their access token
  // was verified against a paid Submission at write time — see
  // app/api/reviews/route.ts). Unique so a single order can back at most
  // one review ("one review per purchase"). Null for older/unverified
  // reviews written before this existed.
  verifiedSubmissionId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}
